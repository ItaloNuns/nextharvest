# Local defaults for docker compose. Copy to .env before starting the API.
# Do not put real keys in this file.

DATABASE_URL=postgresql+asyncpg://nextharvest:nextharvest@127.0.0.1:5433/nextharvest
REDIS_URL=redis://localhost:6379/0

# Optional. Leave empty until the matching connector is implemented.
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASS_API_KEY=
AMS_API_KEY=
OPENET_API_KEY=
GEMINI_API_KEY=

# Local default is fine for docker. Change this before any public deploy.
JWT_SECRET=nextharvest-dev-secret-change-me
JWT_EXPIRE_MINUTES=10080
